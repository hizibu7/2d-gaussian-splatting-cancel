#!/bin/bash
#SBATCH --job-name=p1jac
#SBATCH --output=/data/hizibu7/repos/Seraph/2d-gaussian-splatting/p1_jaccard_out.log
#SBATCH --error=/data/hizibu7/repos/Seraph/2d-gaussian-splatting/p1_jaccard_err.log
#SBATCH --partition=batch_ce_ugrad
#SBATCH --gres=gpu:1
#SBATCH --time=00:20:00
#SBATCH --mem=24G
#SBATCH --cpus-per-task=4
#SBATCH --exclude=moana-r1,moana-r2,moana-u7,moana-u8

source /data/hizibu7/anaconda3/etc/profile.d/conda.sh
conda activate 2dgs
cd /data/hizibu7/repos/Seraph/2d-gaussian-splatting
python p1_jaccard.py \
  -s data/DTU_Full/scan3 \
  -m eval/s1b_lam00_scan3 \
  --iteration 30000 \
  --n_views 50 \
  --cancel_rank_X 0.3

