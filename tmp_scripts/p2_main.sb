#!/bin/bash
#SBATCH --job-name=p2main
#SBATCH --output=logs/p2main_%j.log
#SBATCH --error=logs/p2main_%j.log
#SBATCH --time=02:30:00
#SBATCH --partition=batch_ce_ugrad
#SBATCH --gres=gpu:1
#SBATCH --mem=24G
#SBATCH --cpus-per-task=4
#SBATCH --exclude=moana-r1,moana-r2,moana-u7,moana-u8

set -e
source /data/hizibu7/anaconda3/etc/profile.d/conda.sh
conda activate 2dgs
cd /data/hizibu7/repos/Seraph/2d-gaussian-splatting
METHOD=$1
SEED=$2
SRC=data/DTU/scan3
[ -d data/DTU_Full/scan3 ] && SRC=data/DTU_Full/scan3
[ -d data/DTU/scan3 ] && SRC=data/DTU/scan3
OUT=eval/p2_${METHOD}_seed${SEED}_scan3
rm -rf ${OUT}
python -u train.py \
  -s ${SRC} -m ${OUT} -r 2 \
  --iterations 30000 \
  --split_method ${METHOD} \
  --method_random_seed ${SEED}

